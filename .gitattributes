*.bit filter=lfs diff=lfs merge=lfs -text
*.bmp filter=lfs diff=lfs merge=lfs -text
*.BMP filter=lfs diff=lfs merge=lfs -text

# Preserve original tool-report checksums across checkout.
seed/* -text
seed/*.json text
# Keep native TD reports byte-for-byte, including their table padding.
seed/hdmi_b/* -text -whitespace
seed/hdmi_b/*.json text whitespace
seed/playback_speed/* -text -whitespace
seed/playback_speed/*.json text whitespace
seed/preload_switch_fix/* -text -whitespace
seed/preload_switch_fix/*.json text whitespace
tools/Package_tool/*.exe filter=lfs diff=lfs merge=lfs -text

# Complete offline packager: preserve runtime bytes; large binaries use LFS.
tools/MuseumTFPackager/** -text -whitespace
tools/MuseumTFPackager/**/*.exe filter=lfs diff=lfs merge=lfs -text
tools/MuseumTFPackager/**/*.dll filter=lfs diff=lfs merge=lfs -text
tools/MuseumTFPackager/**/*.pyd filter=lfs diff=lfs merge=lfs -text
tools/MuseumTFPackager/**/*.pt filter=lfs diff=lfs merge=lfs -text
tools/MuseumTFPackager/**/*.zip filter=lfs diff=lfs merge=lfs -text
tools/MuseumTFPackager/**/*.npz filter=lfs diff=lfs merge=lfs -text
tools/MuseumTFPackager/**/*.tiktoken filter=lfs diff=lfs merge=lfs -text
